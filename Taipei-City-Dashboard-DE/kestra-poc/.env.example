# Kestra PoC 設定檔 — 複製成 .env 後填入實際值
#
# DE_DAGS_HOST_PATH 必須是「主機上」Taipei-City-Dashboard-DE/dags 的絕對路徑。
# Kestra 的 docker task runner 會用它當 bind-mount 來源，所以不能用 docker 內路徑。

DE_DAGS_HOST_PATH=/absolute/path/to/Taipei-City-Dashboard/Taipei-City-Dashboard-DE/dags

# ETL 寫入的 Postgres 連線（對應原 Airflow connection: postgres_default）
READY_DATA_DB_URI=postgresql+psycopg2://user:pass@host.docker.internal:5432/dashboard
RAW_DATA_DB_URI=postgresql+psycopg2://user:pass@host.docker.internal:5432/dashboard

# City Dashboard 主 DB（對應原 Airflow connection: dashboad-postgre）
# 只有 eoc_dashboard_controller 會用到，其他 DAG 可以留空但至少要有值
DASHBOARD_DB_URI=postgresql+psycopg2://user:pass@host.docker.internal:5432/dashboardmanager
