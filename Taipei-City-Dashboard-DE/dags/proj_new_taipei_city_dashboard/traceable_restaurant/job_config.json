{
  "dag_infos": {
    "dag_id": "traceable_restaurant",
    "start_date": "2025-07-01",
    "schedule_interval": "@monthly",
    "catchup": false,
    "tags": ["traceable_restaurant", "衛生局", "新北溯源餐廳"],
    "description": "Monthly ETL for New Taipei traceable restaurant list from local xlsx file.",
    "default_args": {
