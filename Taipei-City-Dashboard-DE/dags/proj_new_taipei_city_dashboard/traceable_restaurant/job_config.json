    "gis_format": "point",
    "output_coordinate": "EPSG:4326",
    "is_geometry": 1,
    "dataset_description": "新北市溯源餐廳名單，包含餐廳名稱、料理種類、星級數、地址、電話等資訊。",
    "etl_description": "讀取本地xlsx，解析行政區，地理編碼，轉換為Point幾何存入PostgreSQL。",
    "sensitivity": "public"
  }
