      "retries": 1,
      "retry_delay": 60
    },
    "ready_data_db": "postgres_default",
    "ready_data_default_table": "traceable_restaurant_ntpc",
    "ready_data_history_table": "traceable_restaurant_ntpc_history",
    "raw_data_db": "postgres_default",
    "raw_data_table": "",
    "load_behavior": "current+history"
  },
  "data_infos": {
    "name_cn": "新北市溯源餐廳名單",
