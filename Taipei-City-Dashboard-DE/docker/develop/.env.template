# Taipei City Dashboard DE - local development template
# 1) Copy this file to .env in the same directory.
# 2) Update credentials/hosts if you are using external Redis/PostgreSQL.
# 3) Start services with: docker compose -p de -f docker-compose.yaml up -d --build

# On Linux, set this to your host user id to avoid root-owned files in mounted volumes.
# Example: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=1000

# Optional. Keep this commented unless you need custom path mapping.
# Compose defaults already map:
# - dags/logs/data/plugins from ../../
# - config from ./config
# AIRFLOW_PROJ_DIR=

# Airflow admin account created by airflow-init
USERNAME=airflow
PASSWORD=airflow

# Airflow metadata database (PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:5432/dbname
MATADATA_DATABASE=postgresql+psycopg2://postgres:postgres@de-postgres:5432/airflow

# Celery result backend (PostgreSQL)
# Format: db+postgresql://user:password@host:5432/dbname
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@de-postgres:5432/airflow

# Celery broker (Redis)
# Format: redis://[:password]@host:6379/db
REDIS_CONN=redis://de-redis:6379/0

# If you want DE to connect to root docker/docker-compose-db.yaml instead:
# 1) Start DE with docker-compose.br-dashboard.yaml override.
# 2) Replace values with service names on br_dashboard network.
MATADATA_DATABASE=postgresql+psycopg2://postgres:pgpassword@postgres-manager:5432/airflow
CELERY_RESULT_BACKEND=db+postgresql://postgres:pgpassword@postgres-manager:5432/airflow
REDIS_CONN=redis://redis:6379/0

# Optional, usually keep empty.
_PIP_ADDITIONAL_REQUIREMENTS=
