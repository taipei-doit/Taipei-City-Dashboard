AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=../..
AIRFLOW_METADATA_DB=airflow
AIRFLOW_REDIS_DB=1

# Host port for Airflow web UI. Keep this different from the frontend's 8080.
AIRFLOW_WEBSERVER_PORT=8081
AIRFLOW_WEBSERVER_BASE_URL=http://localhost:8081

# Airflow web UI login created by airflow-init.
USERNAME=airflow
PASSWORD=airflow

# Dashboard data database. Values must match docker/.env for the root DB stack.
DB_DASHBOARD_HOST=postgres-data
DB_DASHBOARD_USER=postgres
DB_DASHBOARD_PASSWORD=
DB_DASHBOARD_DBNAME=dashboard
DB_DASHBOARD_PORT=5432

# Dashboard manager database is also used for Airflow metadata in local develop.
DB_MANAGER_HOST=postgres-manager
DB_MANAGER_USER=postgres
DB_MANAGER_PASSWORD=
DB_MANAGER_DBNAME=dashboardmanager
DB_MANAGER_PORT=5432

# Airflow Variables exposed to DAG code.
DEFAULT_EMAIL_LIST=[]
HTTPS_PROXY_ENABLED=false
PROXY_URL={}
